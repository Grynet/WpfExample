<UserControl x:Class="WpfExample.App.Mvvm.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfExample.App.Mvvm.Views"
             xmlns:viewModels="clr-namespace:WpfExample.App.Mvvm.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance viewModels:ProductsViewModel}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type viewModels:ProductViewModel}">
            <local:ProductView />
        </DataTemplate>        
    </UserControl.Resources>
    
    <Grid>
        <ProgressBar 
            Grid.Column="1" 
            IsIndeterminate="True"
            BorderBrush="Transparent"
            Background="{StaticResource BackgroundLightBrush}"
            Visibility="{Binding LoadDataCommand.IsRunning, 
                         Converter={StaticResource BooleanToVisibilityConverter}}"/>


        <ItemsControl ItemsSource="{Binding Products}"
                      Visibility="{Binding LoadDataCommand.IsRunning, 
                      Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>       

    </Grid>
</UserControl>
