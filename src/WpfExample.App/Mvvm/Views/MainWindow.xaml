<Window x:Class="WpfExample.App.Mvvm.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfExample.App.Mvvm.Views"
        xmlns:viewModels="clr-namespace:WpfExample.App.Mvvm.ViewModels"
        xmlns:converters="clr-namespace:WpfExample.App.Converters"
        d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
        mc:Ignorable="d"
        Height="600" Width="920"
        MinWidth="600"
        MinHeight="300"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="Transparent">

    <Window.Resources>
        <DataTemplate DataType="{x:Type TypeName=viewModels:HeaderViewModel}">
            <local:HeaderView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type TypeName=viewModels:BodyViewModel}">
            <local:BodyView/>
        </DataTemplate>
    </Window.Resources>

    <Border CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ContentControl Content="{Binding Header}" Grid.Row="0" />
            <ContentControl Content="{Binding Body}" Grid.Row="1"/>
            
        </Grid>
    </Border>
</Window>
