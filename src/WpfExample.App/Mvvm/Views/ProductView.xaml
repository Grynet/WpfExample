<UserControl x:Class="WpfExample.App.Mvvm.Views.ProductView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfExample.App.Mvvm.Views"
             xmlns:viewModels="clr-namespace:WpfExample.App.Mvvm.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance viewModels:ProductViewModel}"
             Foreground="{StaticResource TextMutedBrush}"
             Background="{StaticResource BackgroundLightBrush}">


    <Border CornerRadius="8"
        Background="{StaticResource BackgroundLightBrush}"
        BorderBrush="{StaticResource BorderBrush}"
        BorderThickness="1"
        Margin="8"
        Padding="12">

        <StackPanel>
            <DockPanel LastChildFill="False" Margin="0 0 0 6">
                <TextBlock Text="{Binding Name}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PrimaryBrush}"
                       DockPanel.Dock="Left"/>

                <TextBlock Text="{Binding Price, StringFormat={}{0} SEK}"
                       FontSize="14"
                       Foreground="{StaticResource SecondaryBrush}"
                       Margin="16,0,0,0"
                       DockPanel.Dock="Right"/>
            </DockPanel>

            <Border BorderBrush="{StaticResource BorderBrush}"
                Height="1"
                Margin="0 4"/>

            <TextBlock Text="{Binding Description}"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextMutedBrush}"
                   FontSize="13"/>
        </StackPanel>

    </Border>
</UserControl>
