<UserControl x:Class="WpfExample.App.Mvvm.Views.BodyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WpfExample.App.Mvvm.Views"
             xmlns:viewModels="clr-namespace:WpfExample.App.Mvvm.ViewModels"
             d:DataContext="{d:DesignInstance viewModels:BodyViewModel}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="Transparent">
    <Border CornerRadius="0,0,20,20" Background="AliceBlue">
        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>           
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="Gray"
                    BorderThickness="0,0,1,0">
                <StackPanel Grid.Column="0"
                            Margin="20,20,0,0"
                            >
                    <TextBlock Text="This is the first item"/>
                    <TextBlock Text="This is the first item"/>
                    <TextBlock Text="This is the first item"/>
                </StackPanel>
            </Border>

            <TextBlock Grid.Column="1"
                Text="This is the body"
                FontSize="22"
                VerticalAlignment="Center" 
                HorizontalAlignment="center"/>
        </Grid>
        </Border>
</UserControl>
