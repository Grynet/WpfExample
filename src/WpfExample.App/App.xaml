<Application x:Class="WpfExample.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WpfExample.App"
             xmlns:viewModels="clr-namespace:WpfExample.App.Mvvm.ViewModels"
             xmlns:views="clr-namespace:WpfExample.App.Mvvm.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type TypeName=viewModels:HeaderViewModel}">
                <views:HeaderView/>
            </DataTemplate>
            <DataTemplate DataType="{x:Type TypeName=viewModels:BodyViewModel}">
                <views:BodyView/>
            </DataTemplate>
        </ResourceDictionary>      
    </Application.Resources>
</Application>
